{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "paths": {
      "storyboard": ["./src/runtime/index.ts"],
      "@/*": ["./src/editor/*"]
    }
  },
  "include": ["src", "server", "projects/*/scenes/**/*", "projects/*/components/**/*"]
}
