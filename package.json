{
  "name": "storyboard",
  "private": true,
  "version": "0.1.0",
  "description": "Prompt-driven motion design editor: every scene is code, Claude Code or Codex edits it down to the millisecond.",
  "license": "MIT",
  "author": "Saeed Vaziry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saeedvaziry/caleb-video-editor.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "doctor": "tsx server/cli/main.ts doctor",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"server/**/*.test.ts\"",
    "format": "prettier --write \"server/**/*.ts\" \"src/**/*.{ts,tsx,css}\" index.html frame.html",
    "format:check": "prettier --check \"server/**/*.ts\" \"src/**/*.{ts,tsx,css}\" index.html frame.html",
    "analyze": "tsx server/music/cli.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/assistant": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@hono/node-server": "^2.1.3",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "hono": "^4.13.11",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
